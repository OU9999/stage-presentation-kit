            "bottom": 399
          },
          "glyphCount": 19,
          "projectedPixels": 22.66698062294408,
          "stageLogicalPixels": 23.28799135681551
        },
        {
          "text": "이미 남긴 문서와 연결을 따라가 보기로 했다.",
          "class": null,
          "role": null,
          "fontSize": "24px",
          "fontWeight": "400",
          "bbox": {
            "x": 66,
            "y": 408.5,
