          "stageLogicalPixels": 50.4573146064336
        },
        {
          "text": "입문자와 함께하는 짧은 읽기 활동을 준비한다.",
          "class": null,
          "role": null,
          "fontSize": "24px",
          "fontWeight": "400",
          "bbox": {
            "x": 66,
            "y": 275.5,
