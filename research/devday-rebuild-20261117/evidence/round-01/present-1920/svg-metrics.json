          "glyphCount": 25,
          "projectedPixels": 22.66698062294408,
          "stageLogicalPixels": 23.28799135681551
        },
        {
          "text": "본편 뒤에는 15분의 시간이 있다.",
          "class": null,
          "role": null,
          "fontSize": "24px",
          "fontWeight": "400",
          "bbox": {
            "x": 66,
            "y": 311.5,
