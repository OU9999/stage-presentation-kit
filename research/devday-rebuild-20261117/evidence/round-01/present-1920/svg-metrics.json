            "bottom": 338
          },
          "glyphCount": 19,
          "projectedPixels": 22.66698062294408,
          "stageLogicalPixels": 23.28799135681551
        },
        {
          "text": "세 메모를 모두 새로 만드는 대신,",
          "class": null,
          "role": null,
          "fontSize": "24px",
          "fontWeight": "400",
          "bbox": {
            "x": 66,
            "y": 372.5,
