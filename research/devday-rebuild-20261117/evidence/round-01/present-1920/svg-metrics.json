          },
          "glyphCount": 25,
          "projectedPixels": 22.66698062294408,
          "stageLogicalPixels": 23.28799135681551
        },
        {
          "text": "중요한 것은 도구를 설치하는 순서가 아니라",
          "class": null,
          "role": null,
          "fontSize": "24px",
          "fontWeight": "400",
          "bbox": {
