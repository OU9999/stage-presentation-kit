# Keep the shareable PDF; omit QA captures, intermediate renders, and exports.
/output/*
!/output/pdf/
/output/pdf/*
!/output/pdf/stage-sample.pdf
!/output/pdf/product-launch.pdf
!/output/pdf/engineering-review.pdf
!/output/pdf/photo-story.pdf
!/output/pdf/workshop.pdf
!/output/pdf/devday-compositions.pdf
